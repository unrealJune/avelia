<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Avelia.Shell.Windows.Controls.StatusDot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Avelia.Shell.Windows.Converters"
>
    <UserControl.Resources>
        <conv:WorkspaceStatusToLabelConverter x:Key="StatusLabel" />
    </UserControl.Resources>

    <!--
        The dot colour is driven by visual states (toggled from code-behind on
        Status change) rather than a brush-resolving converter: a converter that
        reads Application.Current.Resources can't see brushes that live in a
        merged dictionary's ThemeDictionaries (Tokens.xaml), so it always fell
        back to grey. {ThemeResource} setters resolve against the element's live
        theme and re-resolve on Light/Dark switch.
    -->
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="StatusStates">
                <!-- Draft / Archived: the Ellipse's default tertiary fill. -->
                <VisualState x:Name="DraftState" />
                <VisualState x:Name="ArchivedState" />
                <VisualState x:Name="ActiveState">
                    <VisualState.Setters>
                        <Setter
                            Target="Dot.Fill"
                            Value="{ThemeResource AveliaAccentDefaultBrush}"
                        />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WorkingState">
                    <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource AveliaWarningBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ReadyState">
                    <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource AveliaSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ConflictState">
                    <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource AveliaDangerBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="OpenState">
                    <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource AveliaInfoBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!--
                Independent group driving the "agent working" pulse. Kept separate
                from StatusStates (which only sets Fill) so the colour and the
                pulse compose. The opacity animation lives here as a VSM-managed
                storyboard rather than a hand-rolled one in code-behind: the
                framework re-asserts the active state when the dot is recycled by
                the tab strip / nav-rail list, so the pulse survives reload — a
                code-behind Storyboard.Begin() did not, leaving the dot stuck on
                solid amber after the first streamed events.
            -->
            <VisualStateGroup x:Name="ActivityStates">
                <VisualState x:Name="StaticActivity" />
                <VisualState x:Name="PulsingActivity">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="Dot"
                            Storyboard.TargetProperty="Opacity"
                            From="1.0"
                            To="0.25"
                            Duration="0:0:0.65"
                            AutoReverse="True"
                            RepeatBehavior="Forever"
                        />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Ellipse
            x:Name="Dot"
            Width="8"
            Height="8"
            Fill="{ThemeResource AveliaTextTertiaryBrush}"
            ToolTipService.ToolTip="{x:Bind Status, Converter={StaticResource StatusLabel}, Mode=OneWay}"
        />
    </Grid>
</UserControl>
