<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Avelia.Shell.Windows.Controls.ModelBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <!--
        Unified model bar: model · reasoning effort · context tier in a single
        pill, each a compact dropdown. Replaces the old single ModelBadge and the
        separate Settings radios/toggle (matches VS Code's combined picker).
        Bound to a ModelBarViewModel via the ViewModel DP.
    -->
    <UserControl.Resources>
        <Style x:Key="ModelBarComboStyle" TargetType="ComboBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="DisplayMemberPath" Value="Display" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border
        CornerRadius="{StaticResource AveliaCornerRadiusSmall}"
        Background="{ThemeResource AveliaSubtleFillSecondaryBrush}"
        BorderBrush="{ThemeResource AveliaSurfaceStrokeBrush}"
        BorderThickness="1"
        Padding="2"
    >
        <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
            <Ellipse
                Width="8"
                Height="8"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Fill="{ThemeResource AveliaAccentDefaultBrush}"
            />

            <ComboBox
                x:Name="ModelCombo"
                AutomationProperties.Name="Model"
                AutomationProperties.AutomationId="ModelBarModel"
                Style="{StaticResource ModelBarComboStyle}"
                ItemsSource="{x:Bind ViewModel.ModelOptions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}"
            />

            <Rectangle Width="1" Margin="2,4" Fill="{ThemeResource AveliaSurfaceStrokeBrush}" />

            <FontIcon
                Margin="6,0,0,0"
                FontFamily="Segoe Fluent Icons"
                FontSize="12"
                Glyph="&#xEC4A;"
                Foreground="{ThemeResource AveliaTextTertiaryBrush}"
                VerticalAlignment="Center"
            />
            <ComboBox
                x:Name="ReasoningCombo"
                AutomationProperties.Name="Reasoning effort"
                AutomationProperties.AutomationId="ModelBarReasoning"
                Style="{StaticResource ModelBarComboStyle}"
                ItemsSource="{x:Bind ViewModel.ReasoningOptions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedReasoning, Mode=TwoWay}"
            />

            <Rectangle Width="1" Margin="2,4" Fill="{ThemeResource AveliaSurfaceStrokeBrush}" />

            <FontIcon
                Margin="6,0,0,0"
                FontFamily="Segoe Fluent Icons"
                FontSize="12"
                Glyph="&#xE7C3;"
                Foreground="{ThemeResource AveliaTextTertiaryBrush}"
                VerticalAlignment="Center"
            />
            <ComboBox
                x:Name="ContextCombo"
                AutomationProperties.Name="Context tier"
                AutomationProperties.AutomationId="ModelBarContext"
                Style="{StaticResource ModelBarComboStyle}"
                ItemsSource="{x:Bind ViewModel.ContextOptions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedContext, Mode=TwoWay}"
            />
        </StackPanel>
    </Border>
</UserControl>
