<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Avelia.Shell.Windows.Pages.WorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Avelia.Shell.Windows.Controls"
    xmlns:conv="using:Avelia.Shell.Windows.Converters"
    xmlns:vm="using:Avelia.Shell.Windows.ViewModels"
>
    <Page.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:PathToImageSourceConverter x:Key="PathToImageSource" />

            <!-- ============================================================
                 Conversation message templates (one per MessageViewModel kind)
                 ============================================================ -->

            <!-- 1) Agent message — markdown body with inline code-refs -->
            <DataTemplate x:Key="AgentMessageTemplate" x:DataType="vm:AgentMessageViewModel">
                <Border Padding="0,8,0,8">
                    <controls:MarkdownTextBlock SourceText="{x:Bind Text, FallbackValue=''}" />
                </Border>
            </DataTemplate>

            <!-- 2) Agent error — red banner with icon -->
            <DataTemplate x:Key="AgentErrorTemplate" x:DataType="vm:AgentErrorViewModel">
                <Border
                    Margin="0,4"
                    Background="{ThemeResource AveliaDangerBgBrush}"
                    BorderBrush="{ThemeResource AveliaDangerBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="{StaticResource AveliaCornerRadiusSmall}"
                    Padding="12,10"
                >
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Glyph="&#xE783;"
                            Foreground="{ThemeResource AveliaDangerBrush}"
                            VerticalAlignment="Top"
                        />
                        <controls:CodeRefBlock
                            Grid.Column="1"
                            TextStyle="{StaticResource AveliaMonoBodyTextStyle}"
                            TextWrapping="Wrap"
                            TextForeground="{ThemeResource AveliaDangerBrush}"
                            SourceText="{x:Bind Text, FallbackValue=''}"
                        />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 3) Tool-batch — collapsed strip with summary line -->
            <DataTemplate x:Key="ToolBatchTemplate" x:DataType="vm:ToolBatchViewModel">
                <Border
                    Margin="0,4"
                    Background="{ThemeResource AveliaSubtleFillTertiaryBrush}"
                    BorderBrush="{ThemeResource AveliaSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AveliaCornerRadiusSmall}"
                    Padding="10,8"
                >
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="13"
                            Glyph="&#xE74C;"
                            Foreground="{ThemeResource AveliaTextTertiaryBrush}"
                        />
                        <TextBlock
                            Style="{StaticResource AveliaCaptionTextStyle}"
                            FontFamily="{StaticResource AveliaMonoFontFamily}"
                            Foreground="{ThemeResource AveliaTextSecondaryBrush}"
                            Text="{x:Bind Summary, FallbackValue=''}"
                            VerticalAlignment="Center"
                        />
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="10"
                            Glyph="&#xE70D;"
                            Foreground="{ThemeResource AveliaTextTertiaryBrush}"
                        />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- 4) Change note — file path + diff chips -->
            <DataTemplate x:Key="ChangeNoteTemplate" x:DataType="vm:ChangeNoteViewModel">
                <Border
                    Margin="0,4"
                    Background="{ThemeResource AveliaCardBackgroundBrush}"
                    BorderBrush="{ThemeResource AveliaSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AveliaCornerRadiusSmall}"
                    Padding="12,9"
                >
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="13"
                            Glyph="&#xE8A5;"
                            Foreground="{ThemeResource AveliaTextTertiaryBrush}"
                            VerticalAlignment="Center"
                        />
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="0"
                        >
                            <TextBlock
                                Style="{StaticResource AveliaMonoCaptionTextStyle}"
                                Text="{x:Bind Folder, FallbackValue=''}"
                                Foreground="{ThemeResource AveliaTextTertiaryBrush}"
                            />
                            <TextBlock
                                Style="{StaticResource AveliaMonoCaptionTextStyle}"
                                Text="{x:Bind FileName, FallbackValue=''}"
                                Foreground="{ThemeResource AveliaTextPrimaryBrush}"
                            />
                        </StackPanel>
                        <controls:Chip
                            Grid.Column="2"
                            Margin="0,0,6,0"
                            FillBrush="{ThemeResource AveliaDiffAddBgBrush}"
                            StrokeBrush="{ThemeResource AveliaDiffAddStrongBrush}"
                            TextBrush="{ThemeResource AveliaSuccessBrush}"
                            Text="{x:Bind Add, Mode=OneTime, FallbackValue=''}"
                        />
                        <controls:Chip
                            Grid.Column="3"
                            FillBrush="{ThemeResource AveliaDiffDelBgBrush}"
                            StrokeBrush="{ThemeResource AveliaDiffDelStrongBrush}"
                            TextBrush="{ThemeResource AveliaDangerBrush}"
                            Text="{x:Bind Del, Mode=OneTime, FallbackValue=''}"
                        />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 5) User message — bordered card -->
            <DataTemplate x:Key="UserMessageTemplate" x:DataType="vm:UserMessageViewModel">
                <Border
                    Margin="0,8,0,8"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource AveliaCardBackgroundSecondaryBrush}"
                    BorderBrush="{ThemeResource AveliaSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AveliaCornerRadiusMedium}"
                    Padding="14,10"
                >
                    <StackPanel Spacing="6">
                        <TextBlock
                            Style="{StaticResource AveliaCaptionTextStyle}"
                            Foreground="{ThemeResource AveliaTextTertiaryBrush}"
                            Text="You"
                        />
                        <controls:CodeRefBlock
                            TextStyle="{StaticResource AveliaBodyTextStyle}"
                            TextWrapping="Wrap"
                            SourceText="{x:Bind Text, FallbackValue=''}"
                        />
                        <!-- Image attachments sent with the message. -->
                        <ItemsControl ItemsSource="{x:Bind Refs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border
                                        BorderBrush="{ThemeResource AveliaSurfaceStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource AveliaCornerRadiusSmall}"
                                    >
                                        <Image
                                            MaxWidth="240"
                                            MaxHeight="240"
                                            Stretch="Uniform"
                                            Source="{x:Bind Converter={StaticResource PathToImageSource}}"
                                        />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- 6) Agent markdown — heading + body + numbered list -->
            <DataTemplate x:Key="AgentMarkdownTemplate" x:DataType="vm:AgentMarkdownViewModel">
                <StackPanel Padding="0,8,0,8" Spacing="10">
                    <TextBlock
                        Style="{StaticResource AveliaBodyStrongTextStyle}"
                        Visibility="{x:Bind HasHeading, Mode=OneTime}"
                        Text="{x:Bind Heading, FallbackValue=''}"
                    />
                    <controls:MarkdownTextBlock SourceText="{x:Bind Body, FallbackValue=''}" />
                    <ItemsControl ItemsSource="{x:Bind Items, Mode=OneTime}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AgentMarkdownListItem">
                                <Grid Margin="0,3" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse
                                        Grid.Column="0"
                                        Width="4"
                                        Height="4"
                                        Margin="2,9,0,0"
                                        VerticalAlignment="Top"
                                        Fill="{ThemeResource AveliaTextTertiaryBrush}"
                                    />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock
                                            Style="{StaticResource AveliaBodyStrongTextStyle}"
                                            Text="{x:Bind Bold, FallbackValue=''}"
                                            TextWrapping="Wrap"
                                        />
                                        <TextBlock
                                            Style="{StaticResource AveliaBodyTextStyle}"
                                            Foreground="{ThemeResource AveliaTextSecondaryBrush}"
                                            Text="{x:Bind Detail, FallbackValue=''}"
                                            TextWrapping="Wrap"
                                        />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>

            <!-- Inner selector for a group's collapsed steps. Groups never nest,
                 so this maps only the six leaf shapes. Declared before the group
                 template that uses it to keep StaticResource refs backward-only. -->
            <controls:MessageTemplateSelector
                x:Key="ActivityStepSelector"
                UserTemplate="{StaticResource UserMessageTemplate}"
                AgentTemplate="{StaticResource AgentMessageTemplate}"
                AgentErrorTemplate="{StaticResource AgentErrorTemplate}"
                ToolBatchTemplate="{StaticResource ToolBatchTemplate}"
                ChangeNoteTemplate="{StaticResource ChangeNoteTemplate}"
                AgentMarkdownTemplate="{StaticResource AgentMarkdownTemplate}"
            />

            <!-- 7) Agent activity group — collapsed grey block aggregating a
                 turn's tool calls + intermediate messages. Minimized by default;
                 the Expander's chevron reveals the steps. The inner ItemsControl
                 reuses ActivityStepSelector so each step renders with its own
                 template. -->
            <DataTemplate x:Key="ActivityGroupTemplate" x:DataType="vm:AgentActivityGroupViewModel">
                <Expander
                    Margin="0,4"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="{ThemeResource AveliaSubtleFillTertiaryBrush}"
                    BorderBrush="{ThemeResource AveliaSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AveliaCornerRadiusSmall}"
                    AutomationProperties.AutomationId="AgentActivityGroup"
                    AutomationProperties.Name="{x:Bind Summary, Mode=OneWay}"
                    IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                >
                    <Expander.Header>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center"
                        >
                            <ProgressRing
                                Width="14"
                                Height="14"
                                IsActive="{x:Bind IsActive, Mode=OneWay}"
                                Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Foreground="{ThemeResource AveliaAccentDefaultBrush}"
                            />
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Glyph="&#xE81C;"
                                Foreground="{ThemeResource AveliaTextTertiaryBrush}"
                            />
                            <TextBlock
                                Style="{StaticResource AveliaCaptionTextStyle}"
                                Foreground="{ThemeResource AveliaTextSecondaryBrush}"
                                Text="{x:Bind Summary, Mode=OneWay}"
                                VerticalAlignment="Center"
                            />
                        </StackPanel>
                    </Expander.Header>
                    <ItemsControl
                        ItemsSource="{x:Bind Items, Mode=OneWay}"
                        ItemTemplateSelector="{StaticResource ActivityStepSelector}"
                    />
                </Expander>
            </DataTemplate>

            <!-- Selector wired to all six line shapes + the activity group -->
            <controls:MessageTemplateSelector
                x:Key="MessageSelector"
                UserTemplate="{StaticResource UserMessageTemplate}"
                AgentTemplate="{StaticResource AgentMessageTemplate}"
                AgentErrorTemplate="{StaticResource AgentErrorTemplate}"
                ToolBatchTemplate="{StaticResource ToolBatchTemplate}"
                ChangeNoteTemplate="{StaticResource ChangeNoteTemplate}"
                AgentMarkdownTemplate="{StaticResource AgentMarkdownTemplate}"
                ActivityGroupTemplate="{StaticResource ActivityGroupTemplate}"
            />
        </ResourceDictionary>
    </Page.Resources>

    <!-- Two-column workspace: center + right. Right column is a placeholder
         for Chunk 4 (PR header + file list + terminal). -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- =========== Center column =========== -->
        <Grid Grid.Column="0" Padding="24,16,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Pivot strip + live git status line -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:ChatPivot
                    Grid.Column="0"
                    Threads="{x:Bind ViewModel.Threads, Mode=OneWay}"
                    ActiveThread="{x:Bind ViewModel.ActiveThread, Mode=TwoWay}"
                />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0"
                    AutomationProperties.AutomationId="GitStatusSummary"
                    Style="{StaticResource AveliaCaptionTextStyle}"
                    Foreground="{ThemeResource AveliaTextSecondaryBrush}"
                    Text="{x:Bind ViewModel.GitStatusSummary, Mode=OneWay}"
                />
            </Grid>

            <!-- Transcript: ListView for built-in UI virtualization. The
                 container style strips selection/hover chrome so it reads as
                 a plain stack of message blocks. -->
            <ListView
                Grid.Row="1"
                x:Name="ConversationList"
                AutomationProperties.AutomationId="ConversationList"
                ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                ItemTemplateSelector="{StaticResource MessageSelector}"
                ItemContainerStyle="{StaticResource AveliaTranscriptItemContainerStyle}"
                SelectionMode="None"
                IsItemClickEnabled="False"
                ShowsScrollingPlaceholders="False"
                Background="Transparent"
                BorderThickness="0"
                Padding="0,8,0,8"
                HorizontalContentAlignment="Stretch"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
            />

            <!-- "Working…" indicator. Auto-height + Collapsed when idle, so it
                 adds no layout shift; visible while the agent is processing a
                 turn so the app never looks hung between send and first reply. -->
            <StackPanel
                Grid.Row="2"
                Margin="2,8,0,0"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="AgentWorkingIndicator"
                AutomationProperties.Name="Agent is working"
                Visibility="{x:Bind ViewModel.IsAgentWorking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
            >
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.IsAgentWorking, Mode=OneWay}"
                    Foreground="{ThemeResource AveliaAccentDefaultBrush}"
                />
                <TextBlock
                    Style="{StaticResource AveliaCaptionTextStyle}"
                    Foreground="{ThemeResource AveliaTextSecondaryBrush}"
                    Text="Working…"
                    VerticalAlignment="Center"
                />
            </StackPanel>

            <!-- Composer. Command binding stays OneTime (default) — the
                 command instance never changes; only its CanExecute does, and
                 that's signalled via INotifyChanged on the command itself. -->
            <controls:Composer
                Grid.Row="3"
                Margin="0,8,0,0"
                AutomationProperties.AutomationId="Composer"
                Text="{x:Bind ViewModel.ComposerText, Mode=TwoWay}"
                SendCommand="{x:Bind ViewModel.SendMessageCommand}"
                Attachments="{x:Bind ViewModel.Attachments, Mode=OneWay}"
                ModelBar="{x:Bind ViewModel.ModelBar, Mode=OneWay}"
            />
        </Grid>

        <!-- =========== Right column: PR header + file list + terminal =========== -->
        <Grid
            Grid.Column="1"
            Background="{ThemeResource AveliaCardBackgroundBrush}"
            BorderBrush="{ThemeResource AveliaSurfaceStrokeBrush}"
            BorderThickness="1,0,0,0"
        >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- PR header -->
            <controls:PrHeader
                Grid.Row="0"
                AutomationProperties.AutomationId="PrHeader"
                ViewModel="{x:Bind ViewModel.PrPane, Mode=OneWay}"
            />

            <!-- Hairline + Changes/Files pivot strip. The strip ships as a
                 design affordance for Chunk 10's real backend split between
                 workspace diff and PR diff; today both pivots render the same
                 file list, so the SelectionChanged handler just updates
                 ViewModel.PrPane.ActiveTab without re-querying. The shape is
                 right for the eventual split. -->
            <Border
                Grid.Row="1"
                BorderBrush="{ThemeResource AveliaDividerStrokeBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,4,12,0"
            >
                <SelectorBar
                    AutomationProperties.AutomationId="PrPaneTabStrip"
                    AutomationProperties.Name="Changes or files"
                    SelectionChanged="OnPrPaneTabSelectionChanged"
                >
                    <SelectorBarItem
                        AutomationProperties.AutomationId="PrPaneChangesTab"
                        Text="Changes"
                        IsSelected="True"
                    />
                    <SelectorBarItem
                        AutomationProperties.AutomationId="PrPaneFilesTab"
                        Text="Files"
                    />
                </SelectorBar>
            </Border>

            <!-- File list -->
            <controls:FileChangeList
                Grid.Row="2"
                AutomationProperties.AutomationId="FileChangeList"
                Files="{x:Bind ViewModel.PrPane.Files, Mode=OneWay}"
            />

            <!-- Terminal panel — sticky bottom -->
            <controls:TerminalPanel
                x:Name="TerminalPanelControl"
                Grid.Row="3"
                AutomationProperties.AutomationId="TerminalPanel"
                ViewModel="{x:Bind ViewModel.Terminal, Mode=OneWay}"
            />
        </Grid>
    </Grid>
</Page>
