<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Avelia.Shell.Windows.Pages.SettingsSubpages.AgentsSubpage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Avelia.Shell.Windows.Controls"
    xmlns:vm="using:Avelia.Shell.Windows.ViewModels"
>
    <ScrollViewer
        Padding="4,4,4,16"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
    >
        <StackPanel Spacing="12">
            <!-- Unified default picker: model · reasoning effort · context tier. -->
            <Border
                Background="{ThemeResource AveliaCardBackgroundBrush}"
                BorderBrush="{ThemeResource AveliaSurfaceStrokeBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource AveliaCornerRadiusMedium}"
                Padding="16,14"
            >
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock
                            Style="{StaticResource AveliaBodyStrongTextStyle}"
                            Text="Default model"
                        />
                        <TextBlock
                            Style="{StaticResource AveliaCaptionTextStyle}"
                            Foreground="{ThemeResource AveliaTextSecondaryBrush}"
                            Text="Model, reasoning effort, and context window for new conversations. Override per-conversation in the composer."
                            TextWrapping="Wrap"
                        />
                    </StackPanel>

                    <controls:ModelBar
                        AutomationProperties.AutomationId="AgentsModelBar"
                        HorizontalAlignment="Left"
                        ViewModel="{x:Bind ViewModel.ModelBar, Mode=OneWay}"
                    />
                </StackPanel>
            </Border>

            <!-- GitHub token (Copilot auth) -->
            <Border
                Background="{ThemeResource AveliaCardBackgroundBrush}"
                BorderBrush="{ThemeResource AveliaSurfaceStrokeBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource AveliaCornerRadiusMedium}"
                Padding="16,14"
            >
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock
                            Style="{StaticResource AveliaBodyStrongTextStyle}"
                            Text="GitHub token"
                        />
                        <TextBlock
                            Style="{StaticResource AveliaCaptionTextStyle}"
                            Foreground="{ThemeResource AveliaTextSecondaryBrush}"
                            Text="Copilot uses your GitHub token. Paste a PAT with Copilot access, or set the COPILOT_GITHUB_TOKEN environment variable."
                            TextWrapping="Wrap"
                        />
                    </StackPanel>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox
                            x:Name="GitHubTokenBox"
                            Grid.Column="0"
                            AutomationProperties.AutomationId="GitHubTokenBox"
                            PlaceholderText="ghp_…"
                            PasswordChanged="GitHubTokenBox_PasswordChanged"
                        />
                        <Button
                            Grid.Column="1"
                            AutomationProperties.AutomationId="SaveGitHubTokenButton"
                            Content="Save"
                            Command="{x:Bind ViewModel.SaveGitHubTokenCommand}"
                        />
                    </Grid>

                    <TextBlock
                        AutomationProperties.AutomationId="GitHubTokenStatus"
                        Style="{StaticResource AveliaCaptionTextStyle}"
                        Foreground="{ThemeResource AveliaTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.GitHubStatus, Mode=OneWay}"
                        TextWrapping="Wrap"
                    />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
