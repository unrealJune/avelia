<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <RootNamespace>Avelia.Shell.Windows</RootNamespace>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <Platforms>x64;ARM64</Platforms>
        <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
        <!-- Added by winapp: default RuntimeIdentifier to current architecture when not specified. Only applies when not set via -r or Directory.Build.props. -->
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''"
            >win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier
        >
        <UseWinUI>true</UseWinUI>
        <EnableMsixTooling>true</EnableMsixTooling>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <ApplicationIcon />
        <DefaultLanguage>en-US</DefaultLanguage>
        <AssemblyName>Avelia.Shell.Windows</AssemblyName>
        <Nullable>enable</Nullable>
        <!-- winapp run drops a loose-layout copy of the app into ./AppX. Keep it out of the SDK's default glob. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);AppX\**\*</DefaultItemExcludes>
        <!--
            MVVMTK0045 — MVVM Toolkit 8.4 emits this warning recommending partial
            properties for AOT/CsWinRT, but the toolkit's source generator does not
            yet implement the partial-property feature (the field pattern is the
            only one that compiles). Drop the suppression once we bump past the
            version that ships the generator so a real regression isn't masked.
        -->
        <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- WinApp CLI integration: enables 'dotnet run' support for packaged apps -->
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <!-- Windows App SDK: provides WinUI 3, app lifecycle, windowing, and other modern Windows APIs -->
        <PackageReference Include="Microsoft.WindowsAppSDK" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <Manifest Include="$(ApplicationManifest)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Avelia.Core.Abstractions\Avelia.Core.Abstractions.fsproj" />
        <ProjectReference Include="..\Avelia.Core\Avelia.Core.fsproj" />
        <ProjectReference Include="..\Avelia.Services\Avelia.Services.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Assets\**\*.png" />
        <!--
            Terminal renderer assets (chunk B-7): the xterm.js host page and the
            vendored library (populated by scripts/vendor-xterm.ps1). Copied next
            to the app so TerminalView can serve them from a virtual host.
        -->
        <Content Include="Assets\terminal\**\*.html;Assets\terminal\**\*.css;Assets\terminal\**\*.js;Assets\terminal\**\*.map">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!--
        Bootstrap guard: the xterm.js bundle is fetched by scripts/vendor-xterm.ps1
        rather than committed (see Assets/terminal/vendor/.gitignore). Without it the
        terminal panel loads to a blank WebView2 with no obvious cause. Fail the build
        early with an actionable message instead.
    -->
    <Target Name="EnsureXtermVendored" BeforeTargets="BeforeBuild">
        <Error
            Condition="!Exists('$(MSBuildProjectDirectory)\Assets\terminal\vendor\xterm.js')"
            Text="xterm.js terminal bundle is missing. Run scripts/vendor-xterm.ps1 to fetch it before building (it is intentionally not committed)."
        />
    </Target>

    <!--
        Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
        Tools extension to be activated for this project even if the Windows App SDK Nuget
        package has not yet been restored.
    -->
    <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <ProjectCapability Include="Msix" />
    </ItemGroup>

    <!-- Disable XBF generation for the design-time build to keep clean restore semantics. -->
    <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
    </PropertyGroup>
</Project>
