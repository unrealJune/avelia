    <Compile Include="FactoryTests.fs" />
    <Compile Include="HeadlessIntegrationTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FSharp.Control.TaskSeq" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FsUnit.xUnit" />
    <PackageReference Include="FsCheck.Xunit" />
    <ProjectReference Include="..\..\src\Avelia.Core.Abstractions\Avelia.Core.Abstractions.fsproj" />
    <ProjectReference Include="..\..\src\Avelia.Agent.Copilot\Avelia.Agent.Copilot.fsproj" />
  </ItemGroup>

</Project>
